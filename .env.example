DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CONVERTER_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# LangSmith tracing is opt-in. If enabled, traces contain model prompts and inputs;
# use only data approved for the configured LangSmith workspace.

# Converter Engineering Copilot local services
CONVERTER_DB_PATH=.data/converter_copilot.db
CHROMA_PERSIST_DIR=.data/chroma
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
FASTEMBED_CACHE_DIR=.data/fastembed
CHROMA_COLLECTION_NAME=converter_engineering_copilot_bge_small_zh_v1_5
WEB_ORIGIN=http://localhost:5173

# Durable SQLite worker; use one API instance for the shared local data directory.
CONVERTER_WORKER_CONCURRENCY=1
CONVERTER_WORKER_POLL_SECONDS=0.5
CONVERTER_TASK_LEASE_SECONDS=60
CONVERTER_TASK_TIMEOUT_SECONDS=1800
CONVERTER_TASK_MAX_ATTEMPTS=3

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
